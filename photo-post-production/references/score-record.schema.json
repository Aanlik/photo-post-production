{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Photo post-production score record",
  "type": "object",
  "additionalProperties": false,
  "required": ["primary_category", "secondary_tags", "classification_confidence", "score_version", "evidence", "score_confidence", "style_fit", "technical_gates", "technical", "composition", "light_color", "moment_story", "coherence", "photographic_value", "editability", "expected_gain", "keep_value", "candidate_potential", "final_score", "decision", "strengths", "risks", "recommended_treatment"],
  "properties": {
    "primary_category": {"enum": ["landscape-nature", "urban-landscape", "architecture-urban-space", "street-documentary", "portrait-environmental", "animal-wildlife", "plant-macro", "other-unsupported"]},
    "secondary_tags": {"type": "array", "items": {"type": "string"}},
    "classification_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "score_version": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "category_weights_version": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "model_signals": {"type": "object"},
    "preference_fit": {"$ref": "#/definitions/score"},
    "preference_model_version": {"anyOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
    "comparative_reasons": {"type": "array", "items": {"type": "string"}},
    "burst_rank": {"anyOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
    "score_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "style_fit": {"$ref": "#/definitions/score"},
    "technical_gates": {"type": "object", "minProperties": 1, "additionalProperties": {"enum": ["pass", "warn", "fail"]}},
    "technical": {"$ref": "#/definitions/score"},
    "composition": {"$ref": "#/definitions/score"},
    "light_color": {"$ref": "#/definitions/score"},
    "moment_story": {"$ref": "#/definitions/score"},
    "coherence": {"$ref": "#/definitions/score"},
    "photographic_value": {"$ref": "#/definitions/score"},
    "editability": {"$ref": "#/definitions/score"},
    "expected_gain": {"$ref": "#/definitions/score"},
    "keep_value": {"$ref": "#/definitions/score"},
    "candidate_potential": {"$ref": "#/definitions/score"},
    "final_score": {"anyOf": [{"$ref": "#/definitions/score"}, {"type": "null"}]},
    "decision": {"enum": ["selected", "review", "rejected"]},
    "strengths": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "recommended_treatment": {"type": "array", "items": {"type": "string"}}
  },
  "definitions": {"score": {"type": "number", "minimum": 0, "maximum": 100}}
}
